---
import "../../styles/evidence-pages.css";
const tours = [
 {id:"systems",name:"Systems proof tour",time:"3 MIN",summary:"Break consensus, inspect the oracle, and verify the browser engine is the same C++ source.",stops:[["Enter FAULTLINE","Campaign node 1 and commit a baseline transaction.","/labs/faultline/"],["Create a minority","Isolate the leader and observe what cannot commit.","/labs/faultline/?run=minority-leader"],["Ask the oracle","Compare a witnessed linearizable history with a stale read.","/labs/faultline/#oracle"],["Read the boundary","Separate logical ticks from production latency.","/papers/consensus-under-partition/"]]},
 {id:"autonomy",name:"Autonomy proof tour",time:"3 MIN",summary:"Move from successful tracking to association ghosts and a true observability failure.",stops:[["Maneuver inside bank","Compare single-CV and IMM localization.","/labs/signalroom/?scenario=maneuver&algorithm=advanced"],["Cross two tracks","See why lower localization can still mean worse total OSPA.","/labs/signalroom/?scenario=crossing&algorithm=advanced"],["Remove parallax","Replay the VIO hover failure.","/labs/signalroom/?scenario=hover&algorithm=advanced"],["Follow the limits","Read why each method loses differently.","/papers/sensor-fusion-loses/"]]},
 {id:"quant",name:"Quant proof tour",time:"3 MIN",summary:"Change market toxicity, compare inventory control, and hit AAD with a nonsmooth payoff.",stops:[["Open the tape","Start the deterministic market replay.","/labs/marketwire/"],["Control inventory","Compare naive and inventory-skew regimes.","/labs/marketwire/?strategy=skew&toxicity=28"],["Raise toxicity","Make stale quotes easier to attack.","/labs/marketwire/?strategy=naive&toxicity=82"],["Test the headline","Inspect P&L tradeoffs and the digital-payoff failure.","/papers/benchmarks-that-fight-back/"]]},
 {id:"ml",name:"ML infrastructure tour",time:"3 MIN",summary:"Run a typed graph through rewrites, memory planning, generated WGSL, and a local oracle.",stops:[["Compare shapes","Open KERNELARENA’s live compiler matrix.","/labs/kernelarena/"],["Replay passes","Inspect canonicalization, fusion, DCE, and memory reuse.","https://asp53826.github.io/tensorforge-webgpu/?arena=1#compiler-workbench"],["Read WGSL","Connect scheduled kernels to emitted source.","https://asp53826.github.io/tensorforge-webgpu/?arena=1#generated-code"],["Probe locally","Measure CPU and WebGPU with numerical comparison.","https://asp53826.github.io/tensorforge-webgpu/?arena=1#generated-code"]]}
];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Three-Minute Proof Tours — Aaryan Patel</title><meta name="description" content="Guided three-minute systems, autonomy, quant, and ML infrastructure proof tours." /></head><body><div class="evidence-page"><header class="lab-topbar"><a class="lab-wordmark" href="/"><span>AP</span><strong>Proof Tours</strong></a><nav><a href="/labs/">Laboratories</a><a href="/benchmarks/">Benchmarks</a><a href="/papers/">Papers</a><a aria-current="page" href="/tours/">Tours</a></nav><a class="lab-back" href="/recruiter/">Recruiter route ↗</a></header><main class="evidence-shell"><section class="evidence-hero"><div><p class="evidence-kicker">FOUR ROUTES / THREE MINUTES EACH</p><h1>Choose a claim.<br />Attack it.</h1></div><p>Each route is a deliberately short sequence: mechanism, adversarial condition, oracle, boundary. A reviewer can stop after three minutes or follow any claim into code and tests.</p></section>{tours.map((tour) => <section id={tour.id}><div class="evidence-titlebar"><div><p class="evidence-kicker">{tour.time} / GUIDED ROUTE</p><h2>{tour.name}</h2></div><p>{tour.summary}</p></div><div class="tour-sequence">{tour.stops.map((stop) => <article class="tour-stop"><h3>{stop[0]}</h3><p>{stop[1]}</p><a href={stop[2]}>OPEN STOP →</a></article>)}</div></section>)}</main></div></body></html>
