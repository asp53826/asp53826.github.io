const films = [
 {id:"faultline",lab:"SYSTEMS / 58 SECONDS",title:"A leader alone is not a majority",summary:"Partition a five-node cluster, observe the stale leader, heal the network, and ask the checker for a witness.",poster:"/media/cinema/faultline-poster.svg",video:"/media/cinema/faultline.mp4",captions:"/media/cinema/faultline.vtt",labUrl:"/labs/faultline/"},
 {id:"signalroom",lab:"AUTONOMY / 55 SECONDS",title:"The advanced estimator loses",summary:"Watch IMM win inside its bank, JPDA sustain ghosts, and VIO fail when hover removes parallax.",poster:"/media/cinema/signalroom-poster.svg",video:"/media/cinema/signalroom.mp4",captions:"/media/cinema/signalroom.vtt",labUrl:"/labs/signalroom/"},
 {id:"marketwire",lab:"QUANT / 52 SECONDS",title:"Profit is not the only state variable",summary:"Compare gross P&L with inventory dispersion, then apply pathwise AAD to the payoff it cannot differentiate.",poster:"/media/cinema/marketwire-poster.svg",video:"/media/cinema/marketwire.mp4",captions:"/media/cinema/marketwire.vtt",labUrl:"/labs/marketwire/"},
 {id:"kernelarena",lab:"ML INFRA / 57 SECONDS",title:"A compiler rewrite you can interrogate",summary:"Follow typed IR through fusion, liveness-aware allocation, generated WGSL, and a local correctness probe.",poster:"/media/cinema/kernelarena-poster.svg",video:"/media/cinema/kernelarena.mp4",captions:"/media/cinema/kernelarena.vtt",labUrl:"/labs/kernelarena/"}
